# =============================================================================
# GEKO Magazine Web App - Git Ignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/

# Database locale
*.db
*.sqlite3
data/geko.db

# File caricati (volumi Docker)
data/images/*
data/output/*
data/articles/*
# Media library per-articolo + copertine (dati di PRODUZIONE). DEVE stare qui:
# il checkout main è anche la dir di deploy, e un `git clean -fd` cancellerebbe
# questi file se non ignorati (è già successo: 9/7/2026, uploads azzerata).
data/uploads/*
!data/uploads/.gitkeep
!data/.gitkeep

# Typst generato
typst/generated/*
!typst/generated/.gitkeep

# Symlink locali verso template/assets (in Docker sono bind-mount, vedi
# docker-compose*.yml; per checkout locali/CI li crea tests/conftest.py)
/typst/template.typ
/typst/assets

# Environment
.env
.env.local
.env.*.local

# Secrets (API keys, passwords)
secrets/*
!secrets/*.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
logs/
/typst/src
